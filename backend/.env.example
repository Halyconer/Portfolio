# Environment Configuration Example
# Copy this file to .env and modify as needed

# Set to 'development' to allow curl/Postman requests, 'production' for strict origin checking
FLASK_ENV=development

# Development mode flag - set to 'true' to enable development features
# When true, allows requests from any origin and skips authentication checks
DEVELOPMENT_MODE=true

# NOTE: the LIFX bulb is discovered via LAN broadcast at runtime
# (see get_bulb() in app.py), so there is no BULB_IP variable.
# This is a change from the old Yeelight setup, which did need a hardcoded IP.

# Allowed origin for production mode - only requests from this origin will be allowed.
# Note: CORS is now actually handled by nginx (see nginx/nginx.conf) — this var is
# kept for the Flask app's logging and any defensive Origin checks. The real
# allowlist lives in the nginx `map $http_origin $cors_origin { ... }` block.
ALLOWED_ORIGIN=https://adrianeddy.com
