# Environment Configuration Example
# Copy this file to .env and modify as needed

# Set to 'development' to allow curl/Postman requests, 'production' for strict origin checking
FLASK_ENV=development

# Development mode flag - set to 'true' to enable development features
# When true, allows requests from any origin and skips authentication checks
DEVELOPMENT_MODE=true

# LIFX bulb addressing — used by get_bulb() in app.py.
#
# If both BULB_MAC and BULB_IP are set, the app talks to the bulb via unicast
# UDP and skips broadcast discovery entirely. This is required on networks
# where the router drops broadcast UDP between mesh nodes (Linksys Velop,
# many other mesh systems). If left unset, the app falls back to LAN
# broadcast discovery, which works on simpler networks.
#
# Find the MAC + IP by running `arp -a` on the Pi and looking for entries
# with the LIFX OUI prefix `d0:73:d5:*`. Reserve the IP in your router's
# DHCP so it doesn't change across reboots.
# BULB_MAC=d0:73:d5:xx:xx:xx
# BULB_IP=192.168.1.xx

# Allowed origin for production mode - only requests from this origin will be allowed.
# Note: CORS is now actually handled by nginx (see nginx/nginx.conf) — this var is
# kept for the Flask app's logging and any defensive Origin checks. The real
# allowlist lives in the nginx `map $http_origin $cors_origin { ... }` block.
ALLOWED_ORIGIN=https://adrianeddy.com
